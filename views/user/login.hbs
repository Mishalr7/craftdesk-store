<section class="login-page container">
  <h1 class="login-title">My Account</h1>

  <div class="login-grid">
    <div class="login-box">
      <h3>Login</h3>

      {{#if loginError}}
        <p class="error-text">Invalid email or password</p>
      {{/if}}
      {{#if notVerified}}
        <p class="error-text">Please verify your email address before logging in.</p>
        <form action="/resend-verification" method="POST" style="margin-bottom:1rem;">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="email" value="{{unverifiedEmail}}">
          <button type="submit" class="btn-outline" style="padding:6px 12px;font-size:0.85rem;">Resend Verification Email</button>
        </form>
      {{/if}}
      {{#if verifySent}}
        <p class="text-success" style="font-weight:600;">Verification link sent! Please check your email inbox before logging in.</p>
      {{/if}}
      {{#if verifiedSuccess}}
        <p class="text-success" style="font-weight:600;">Email verified successfully! You can now log in.</p>
      {{/if}}
      {{#if verifiedInvalid}}
        <p class="error-text">Verification link is invalid or has expired. Please log in to request a new link.</p>
      {{/if}}
      {{#if resetSuccess}}
        <p class="text-success" style="font-weight:600;">Password reset successfully! Please log in.</p>
      {{/if}}

      <form action="/login" method="post">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input placeholder="Email" name="email" required>
<div class="password-wrap">
  <input 
    type="password" 
    id="password"
    name="password"
    placeholder="Password"
    required
  >
  <i class="bi bi-eye password-toggle" onclick="togglePassword('password', this)"></i>
</div>



        <button class="btn-main">Sign In</button>
        <p class="switch-text" style="margin-top:0.75rem;">
          <a href="/forgot" class="forgot-link">Forgot password?</a>
        </p>
      </form>
    </div>

    <div class="login-box">
      <h3>New Customer</h3>
      <p>Sign up for early access and special offers.</p>
      <a href="/signup" class="btn-signup">Sign Up</a>
    </div>
  </div>
</section>
