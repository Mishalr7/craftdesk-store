<section class="login-page container">
  <h1 class="login-title">Reset Password</h1>

  <div class="login-grid" style="justify-content: center;">
    <div class="login-box" style="max-width:420px; width:100%;">
      <h3>Create a new password</h3>

      {{#if error}}
        <p class="error-text">{{error}}</p>
      {{/if}}

      <form action="/reset-password/{{token}}" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div class="password-wrap" style="margin-bottom:1rem;">
          <input
            type="password"
            id="newPassword"
            name="newPassword"
            placeholder="New Password"
            required
          >
          <i class="bi bi-eye password-toggle" onclick="togglePassword('newPassword', this)"></i>
        </div>

        <div class="password-wrap" style="margin-bottom:1rem;">
          <input
            type="password"
            id="confirmNewPassword"
            name="confirmNewPassword"
            placeholder="Confirm New Password"
            required
          >
          <i class="bi bi-eye password-toggle" onclick="togglePassword('confirmNewPassword', this)"></i>
        </div>

        <p id="resetPasswordError" class="error-text" style="display:none;">Passwords do not match</p>

        <button type="submit" class="btn-main">Reset Password</button>
      </form>

      <script>
        document.querySelector('form').addEventListener('submit', function(e) {
          const pwd = document.getElementById('newPassword').value;
          const confirm = document.getElementById('confirmNewPassword').value;
          const err = document.getElementById('resetPasswordError');
          if (pwd !== confirm) {
            e.preventDefault();
            err.style.display = 'block';
          } else {
            err.style.display = 'none';
          }
        });
      </script>
    </div>
  </div>
</section>
