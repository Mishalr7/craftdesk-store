<section class="login-page container">
  <h1 class="login-title">Forgot Password</h1>

  <div class="login-grid" style="justify-content: center;">
    <div class="login-box" style="max-width:420px; width:100%;">
      <h3>Reset your password</h3>
      <p class="text-muted" style="font-size:0.9rem; margin-bottom:1.2rem;">
        Enter your email and we'll send a reset link to your inbox.
      </p>

      {{#if error}}
        <p class="error-text">{{error}}</p>
      {{/if}}
      {{#if success}}
        <p class="text-success" style="font-weight:600;">{{success}}</p>
      {{/if}}

      <form action="/forgot" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="email" name="email" placeholder="Email address" required style="margin-bottom:1rem;">
        <button type="submit" class="btn-main">Send Reset Link</button>
      </form>

      <p class="switch-text" style="margin-top:1rem;">
        <a href="/login">← Back to Login</a>
      </p>
    </div>
  </div>
</section>
