<section class="container py-4">

  <div class="mb-4">
    <h2 class="admin-title mb-1">Admin Profile</h2>
    <p class="admin-subtitle mb-0">Account details and system security status</p>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card p-4 admin-card h-100">
        <h5 class="mb-3"><i class="bi bi-person-badge me-2 text-info"></i>Account Information</h5>
        <div class="mb-3">
          <div class="text-secondary small">Admin Email</div>
          <div class="fw-semibold fs-5">{{profile.email}}</div>
        </div>
        <div class="mb-3">
          <div class="text-secondary small">Role</div>
          <div><span class="badge bg-info text-dark">Store Administrator</span></div>
        </div>
        <div>
          <div class="text-secondary small">Base URL</div>
          <div class="font-monospace">{{profile.baseUrl}}</div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card p-4 admin-card h-100">
        <h5 class="mb-3"><i class="bi bi-shield-check me-2 text-success"></i>System & Security Status</h5>
        <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
          <li class="d-flex justify-content-between align-items-center">
            <span class="text-secondary">Environment</span>
            <span class="badge bg-secondary">{{profile.environment}}</span>
          </li>
          <li class="d-flex justify-content-between align-items-center">
            <span class="text-secondary">Razorpay Gateway</span>
            <span class="badge {{#if (eq profile.razorpayMode 'Live Mode')}}bg-success{{else}}bg-warning text-dark{{/if}}">{{profile.razorpayMode}}</span>
          </li>
          <li class="d-flex justify-content-between align-items-center">
            <span class="text-secondary">Gmail SMTP (Emails)</span>
            {{#if profile.gmailConfigured}}
              <span class="badge bg-success">Configured</span>
            {{else}}
              <span class="badge bg-danger">Not Configured</span>
            {{/if}}
          </li>
          <li class="d-flex justify-content-between align-items-center">
            <span class="text-secondary">Session Store</span>
            <span class="badge bg-success">MongoDB Persistent</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

</section>
