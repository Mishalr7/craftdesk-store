<section class="container py-4">

  <div class="admin-products-card p-4">

    <h2 class="text-white fw-bold mb-4">Add New Product</h2>

    <form action="/admin/add-product" method="POST" enctype="multipart/form-data">

      <div class="mb-3">
        <label class="admin-muted">Product Name</label>
        <input name="name" class="form-control admin-input-dark" required>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="admin-muted">Selling / Offer Price (₹)</label>
          <input name="price" type="number" min="0" class="form-control admin-input-dark" required>
        </div>
        <div class="col-md-6">
          <label class="admin-muted">Original Price / MRP (₹) <small>(optional, for Offers)</small></label>
          <input name="originalPrice" type="number" min="0" class="form-control admin-input-dark" placeholder="Leave blank if no offer">
        </div>
      </div>

      <div class="mb-3">
        <label class="admin-muted">Brand</label>
        <input name="brand" class="form-control admin-input-dark">
      </div>
      
      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="admin-muted mb-0">Category</label>
          <a href="/admin/categories" class="small text-info text-decoration-none">+ Manage Categories</a>
        </div>
        <select name="category" class="form-control admin-input-dark" required>
          <option value="" disabled selected>Select a category</option>
          {{#each categories}}
            <option value="{{this.name}}">{{this.name}}</option>
          {{/each}}
        </select>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="admin-muted">Stock Quantity</label>
          <input name="stockCount" type="number" min="0" value="10" class="form-control admin-input-dark" required>
        </div>
        <div class="col-md-6">
          <label class="admin-muted">Stock Status</label>
          <select name="stock" class="form-control admin-input-dark">
            <option value="true">In Stock</option>
            <option value="false">Out of Stock</option>
          </select>
        </div>
      </div>

      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="isFeatured" name="isFeatured">
        <label class="form-check-label admin-muted" for="isFeatured">Feature on Home Page (shown first)</label>
      </div>

      <div class="p-3 mb-3 rounded" style="background: rgba(255,255,255,0.03); border: 1px solid #1f2a44;">
        <h6 class="text-white fw-semibold mb-3"><i class="bi bi-image me-2 text-info"></i>Main Cover Image (Shown on Store Cards) *</h6>
        <div class="mb-2">
          <label class="admin-muted">Upload Main Image</label>
          <input name="mainImage" type="file" accept="image/*" class="form-control admin-input-dark">
        </div>
        <div>
          <label class="admin-muted">Or Main Image URL</label>
          <input name="mainImageUrl" class="form-control admin-input-dark" placeholder="https://example.com/main-cover.jpg">
        </div>
      </div>

      <div class="p-3 mb-3 rounded" style="background: rgba(255,255,255,0.03); border: 1px solid #1f2a44;">
        <h6 class="text-white fw-semibold mb-3"><i class="bi bi-images me-2 text-info"></i>Additional Gallery Images (Optional, up to 4)</h6>
        <div class="mb-2">
          <label class="admin-muted">Upload Extra Images</label>
          <input name="galleryImages" type="file" accept="image/*" class="form-control admin-input-dark" multiple>
          <small class="admin-muted">Hold Ctrl / Cmd to select multiple files</small>
        </div>
        <div>
          <label class="admin-muted">Or Extra Image URLs (one per line or comma-separated)</label>
          <textarea name="galleryImageUrls" class="form-control admin-input-dark" rows="2" placeholder="https://example.com/side-view.jpg&#10;https://example.com/back-view.jpg"></textarea>
        </div>
      </div>

      <div class="mb-3">
        <label class="admin-muted">Description</label>
        <textarea name="description" class="form-control admin-input-dark" rows="4"></textarea>
      </div>

      <button type="submit" class="btn btn-primary px-4">
        Save Product
      </button>

    </form>

  </div>

</section>

<!-- Client-Side Validation -->
<script>
document.querySelector("form").addEventListener("submit", function(e){

  const files = document.querySelector('input[name="mainImage"]').files;
  const imageUrl = document.querySelector('input[name="mainImageUrl"]').value.trim();

  if (!files.length && imageUrl === "") {
      e.preventDefault();

      Swal.fire({
        icon: 'error',
        title: 'Main Image Required',
        text: 'Please upload a main cover image or provide a main image URL.',
        background: '#0b1626',
        color: '#fff',
        confirmButtonColor: '#ff4d4d'
      });
  }
});
</script>

<!-- Backend Validation Error -->
{{#if error}}
<script>
Swal.fire({
  icon: 'error',
  title: 'Missing Image',
  text: '{{error}}',
  background: '#0b1626',
  color: '#fff',
  confirmButtonColor: '#ff4d4d'
})
</script>
{{/if}}
