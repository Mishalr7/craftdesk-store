<header>
    <!-- Premium Top Bar -->
    <div class="top-bar text-center">
      Free Shipping on orders above ₹999 • Exclusive Deals Everyday
    </div>

    <nav class="navbar navbar-expand-lg premium-nav shadow-sm">
      <div class="container">

        <!-- 1. Brand (Far Left) -->
        <a class="navbar-brand fw-bold" href="/">
          <i class="bi bi-bag-check-fill me-2 brand-icon"></i>
          CraftDesk<span class="accent"> Online</span>
        </a>

        <!-- 2. Navigation Menu & Desktop Search (Center / Middle on Desktop) -->
        <div class="collapse navbar-collapse" id="navBar">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link {{#if (eq activeNav 'home')}}active{{/if}}" href="/">Home</a></li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle {{#if (eq activeNav 'categories')}}active{{/if}}" data-bs-toggle="dropdown" style="cursor:pointer;">Categories</a>
              <ul class="dropdown-menu">
                {{#each categories}}
                  <li><a class="dropdown-item" href="/?category={{encodeURIComponent this.name}}">{{this.name}}</a></li>
                {{/each}}
              </ul>
            </li>

            <li class="nav-item"><a class="nav-link {{#if (eq activeNav 'new-arrivals')}}active{{/if}}" href="/?sort=newest">New Arrivals</a></li>
            <li class="nav-item"><a class="nav-link {{#if (eq activeNav 'offers')}}active{{/if}}" href="/?offers=true">Offers</a></li>
            <li class="nav-item"><a class="nav-link {{#if (eq activeNav 'blog')}}active{{/if}}" href="/blog">Blog</a></li>
          </ul>

          <!-- Desktop Search -->
          <form action="/" method="GET" class="d-flex me-3 search-area d-none d-lg-flex">
            <input class="form-control" type="search" name="q" value="{{searchQuery}}" placeholder="Search products...">
          </form>
        </div>

        <!-- 3. Header Utility Controls (Far Right on Desktop & Mobile) -->
        <div class="d-flex align-items-center gap-2 gap-sm-3 header-controls ms-auto">

          <!-- Sleek Pill Theme Switch Button -->
          <button type="button" class="theme-switch-pill theme-toggle-btn" onclick="toggleTheme()" aria-label="Toggle light and dark theme">
            <span class="theme-pill-track">
              <span class="theme-pill-thumb">
                <i class="bi bi-sun-fill sun-icon"></i>
                <i class="bi bi-moon-stars-fill moon-icon"></i>
              </span>
            </span>
          </button>

          <!-- User Account -->
          {{#if user}}
            <a href="/account" class="icon-tip nav-icon-link" data-tip="{{user.firstName}}">
              <i class="bi bi-person"></i>
            </a>
          {{else}}
            <a href="/login" class="icon-tip nav-icon-link" data-tip="Login">
              <i class="bi bi-person"></i>
            </a>
          {{/if}}

          <!-- Cart Badge -->
          <a href="/cart" class="position-relative nav-cart icon-tip nav-icon-link" data-tip="Cart">
            <i class="bi bi-bag-fill"></i>
            <span class="cart-badge">{{cartCount}}</span>
          </a>

          <!-- Hamburger Toggler (Mobile Only) -->
          <button class="navbar-toggler ms-1" type="button" data-bs-toggle="collapse" data-bs-target="#navBar" aria-controls="navBar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>

        </div>

        <!-- 4. Mobile Search (Sub-row) -->
        <form action="/" method="GET" class="search-area d-lg-none mt-2 w-100">
          <input class="form-control" type="search" name="q" value="{{searchQuery}}" placeholder="Search products...">
        </form>
      </div>
    </nav>

  </header>