<script>
  function togglePassword(inputId, icon) {
    const input = document.getElementById(inputId);

    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      input.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }

  // Signup password match check
  const signupForm = document.querySelector(".signup-form");

  if (signupForm) {
    signupForm.addEventListener("submit", function (e) {
      const pwd = document.getElementById("password").value;
      const confirmPwd = document.getElementById("confirmPassword").value;
      const error = document.getElementById("passwordError");

      if (pwd !== confirmPwd) {
        e.preventDefault();
        error.style.display = "block";
      } else {
        error.style.display = "none";
      }
    });
  }

  function updateThemeUI(theme) {
    document.documentElement.setAttribute('data-bs-theme', theme);
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);

    const toggleBtns = document.querySelectorAll('.theme-toggle-btn');
    toggleBtns.forEach(btn => {
      const sunIcon = btn.querySelector('.sun-icon');
      const moonIcon = btn.querySelector('.moon-icon');
      const text = btn.querySelector('.theme-text');
      if (theme === 'dark') {
        btn.classList.add('is-dark');
        if (sunIcon) sunIcon.style.display = 'none';
        if (moonIcon) moonIcon.style.display = 'inline-block';
        if (text) text.textContent = 'Light Mode';
        btn.setAttribute('title', 'Switch to Light Mode');
      } else {
        btn.classList.remove('is-dark');
        if (sunIcon) sunIcon.style.display = 'inline-block';
        if (moonIcon) moonIcon.style.display = 'none';
        if (text) text.textContent = 'Dark Mode';
        btn.setAttribute('title', 'Switch to Dark Mode');
      }
    });
  }

  function toggleTheme() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    updateThemeUI(newTheme);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);
  });

  // Sync cart badge when navigating back/forward via browser cache (bfcache / back_forward)
  window.addEventListener('pageshow', async (event) => {
    const navEntries = performance.getEntriesByType ? performance.getEntriesByType('navigation') : [];
    const isBackForward = event.persisted || (navEntries[0] && navEntries[0].type === 'back_forward');
    if (isBackForward) {
      try {
        const res = await fetch('/cart-count', { cache: 'no-store' });
        const data = await res.json();
        if (typeof data.cartCount === 'number') {
          document.querySelectorAll('.cart-badge').forEach(b => {
            b.innerText = data.cartCount;
          });
        }
      } catch (e) {}
    }
  });
</script>



