
<main>
  <section class="featured-products py-4">
<div class="container my-4">
  {{#if isFiltered}}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <h2 class="section-title mb-0">{{pageTitle}}</h2>
      <a href="/" class="btn btn-outline-secondary btn-sm">View All Products</a>
    </div>
  {{else}}
    <h2 class="section-title mb-4">Featured Products</h2>
  {{/if}}

  {{#unless products.length}}
    <div class="text-center py-5">
      <p class="text-muted fs-5">No products found.</p>
      {{#if isFiltered}}
        <a href="/" class="btn-main">View All Products</a>
      {{/if}}
    </div>
  {{/unless}}

  <div class="products-grid">
    {{#each products}}

    <!-- CARD -->
<div class="product-card">
  <div class="product-img position-relative">
    {{#if this.hasOffer}}
      <span class="badge bg-danger position-absolute top-0 start-0 m-2" style="z-index:2;">{{this.discountPercent}}% OFF</span>
    {{/if}}
    <a href="/product/{{this._id}}" class="d-block w-100 h-100">
      {{#if this.images}}
        {{#if (startsWith this.images.[0] "http")}}
          <img src="{{this.images.[0]}}" alt="{{this.name}}">
        {{else}}
          <img src="/product-images/{{this.images.[0]}}" alt="{{this.name}}">
        {{/if}}
      {{else}}
        <img src="/img/no-image.png" alt="No image">
      {{/if}}
    </a>
  </div>

  <div class="product-info">
    <h5 class="price">
      ₹{{this.price}}
      {{#if this.hasOffer}}
        <span class="text-muted text-decoration-line-through ms-1" style="font-size:0.85rem;font-weight:400;">₹{{this.originalPrice}}</span>
      {{/if}}
    </h5>
    <a href="/product/{{this._id}}" class="text-decoration-none text-reset">
      <p class="title">{{this.name}}</p>
    </a>
    {{#if this.brand}}
  <span class="brand">{{this.brand}}</span>
{{/if}}


    {{#if this.stock}}
      <span class="badge bg-success">In Stock</span>
      {{#if this.lowStock}}
        <small class="text-danger fw-semibold ms-1">Only {{this.stockCount}} left</small>
      {{/if}}
    {{else}}
      <span class="badge bg-danger">Out of Stock</span>
    {{/if}}
  </div>

  <div class="actions">
    <a href="/product/{{this._id}}" class="btn-outline">
      Quick View
    </a>

    {{#if this.stock}}
  <button
  class="btn-main"
  onclick="addToCart('{{this._id}}')">

  Add to Cart

</button>
    {{else}}
      <button class="btn-main disabled-btn" disabled>
        Out of Stock
      </button>
    {{/if}}
  </div>
</div>

    <!-- END CARD -->
{{/each}}
   

  </div>
</div>
  </section>
</main>
<script>

async function addToCart(productId){

  try{

    const response =
      await fetch('/add-to-cart/' + productId)

    const data = await response.json()

    if(data.status){
const badges =
  document.querySelectorAll('.cart-badge')

badges.forEach(badge => {

  badge.innerText = typeof data.cartCount === 'number'
    ? data.cartCount
    : Number(badge.innerText) + 1

})

    } else if (data.message) {
      if (typeof Swal !== 'undefined') {
        Swal.fire({ icon: 'warning', title: 'Stock Limit', text: data.message });
      } else {
        alert(data.message);
      }
    }

  }catch(err){

    console.log(err)

  }

}

</script>